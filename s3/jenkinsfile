pipeline {
  agent any

  parameters {
    string(
      name: 'REGION',
      defaultValue: 'ap-south-1',
      description: 'AWS Region'
    )
    string(
      name: 'OWNER_NAME',
      defaultValue: 'sahil',
      description: 'Owner name to store in tags'
    )
    string(
      name: 'NAME',
      defaultValue: 'demo',
      description: 'Bucket base name'
    )
    string(
      name: 'SUFFIX',
      defaultValue: '001',
      description: 'Unique suffix to make the bucket globally unique'
    )
    choice(
      name: 'ACTION',
      choices: ['apply', 'destroy'],
      description: 'Choose whether to create or delete the S3 bucket'
    )
  }

  environment {
    TF_CLI_ARGS = '-no-color'
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: 'main',
            url: 'https://github.com/Sahilispro/terraform-with-AWS.git/'
      }
    }

    stage('Terraform Init') {
      steps {
        dir('s3') {
          withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws_jenkins']
          ]) {
            bat 'terraform init'
          }
        }
      }
    }

    stage('Terraform Action') {
      steps {
        dir('s3') {
          withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws_jenkins']
          ]) {
            script {
              if (params.ACTION == 'apply') {
                bat '''
                  terraform plan ^
                    -var="region=%REGION%" ^
                    -var="owner_name=%OWNER_NAME%" ^
                    -var="name=%NAME%" ^
                    -var="suffix=%SUFFIX%" ^
                    -out=tfplan

                  terraform apply -auto-approve tfplan
                '''
              } else if (params.ACTION == 'destroy') {
                bat '''
                  terraform destroy -auto-approve ^
                    -var="region=%REGION%" ^
                    -var="owner_name=%OWNER_NAME%" ^
                    -var="name=%NAME%" ^
                    -var="suffix=%SUFFIX%"
                '''
              }
            }
          }
        }
      }
    }
  }

  post {
    success {
      script {
        if (params.ACTION == 'apply') {
          echo 'Apply succeeded. Keeping workspace to preserve Terraform state.'
        } else {
          echo 'Destroy completed. Cleaning workspace.'
          cleanWs()
        }
      }
    }
    failure {
      echo 'Job failed. Cleaning workspace.'
      cleanWs()
    }
    aborted {
      echo 'Job aborted. Cleaning workspace.'
      cleanWs()
    }
  }
}
