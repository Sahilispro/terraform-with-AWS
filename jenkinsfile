pipeline {
  agent any

  parameters {
    string(
      name: 'REGION',
      defaultValue: 'ap-south-1',
      description: 'AWS Region'
    )
    string(
      name: 'OWNER_NAME',
      defaultValue: 'sahil',
      description: 'Owner name to store in tags'
    )
    string(
      name: 'NAME',
      defaultValue: 'demo',
      description: 'Bucket base name'
    )
    string(
      name: 'SUFFIX',
      defaultValue: '001',
      description: 'Unique suffix to make the bucket globally unique'
    )
    choice(
      name: 'ACTION',
      choices: ['apply', 'destroy'],
      description: 'Choose whether to create or delete the S3 bucket'
    )
    choice(
      name: 'AUTO_APPROVE',
      choices: ['false', 'true'],
      description: 'Set to true to skip the manual approval gate'
    )
  }

  environment {
    TF_CLI_ARGS = '-no-color'
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: 'main',
            url: 'https://github.com/Sahilispro/terraform-with-AWS.git/'
      }
    }

    stage('Terraform Format Check') {
      steps {
        dir('s3') {
          withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws_jenkins']
          ]) {
            bat 'terraform fmt -check'
          }
        }
      }
    }

    stage('Terraform Init') {
      steps {
        dir('s3') {
          withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws_jenkins']
          ]) {
            bat 'terraform init'
          }
        }
      }
    }

    stage('Terraform Validate') {
      steps {
        dir('s3') {
          withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws_jenkins']
          ]) {
            bat 'terraform validate'
          }
        }
      }
    }

    stage('Terraform Lint') {
      steps {
        dir('s3') {
          withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws_jenkins']
          ]) {
            bat '''
              tflint --init
              tflint
            '''
          }
        }
      }
    }

    stage('Terraform Plan') {
      when {
        expression { params.ACTION == 'apply' }
      }
      steps {
        dir('s3') {
          withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws_jenkins']
          ]) {
            bat '''
              terraform plan ^
                -var="region=%REGION%" ^
                -var="owner_name=%OWNER_NAME%" ^
                -var="name=%NAME%" ^
                -var="suffix=%SUFFIX%" ^
                -out=tfplan
            '''
          }
        }
      }
    }

    stage('Approval Gate') {
      when {
        expression {
          (params.ACTION == 'apply' && params.AUTO_APPROVE == 'false') ||
          (params.ACTION == 'destroy' && params.AUTO_APPROVE == 'false')
        }
      }
      steps {
        input(
          message: "Approve Terraform ${params.ACTION} for bucket ${params.NAME}-${params.SUFFIX}?",
          ok: 'Approve',
          submitter: 'admin,jenkins'
        )
      }
    }

    stage('Terraform Apply') {
      when {
        expression { params.ACTION == 'apply' }
      }
      steps {
        dir('s3') {
          withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws_jenkins']
          ]) {
            bat '''
              terraform apply -auto-approve tfplan
            '''
          }
        }
      }
    }

    stage('Terraform Destroy') {
      when {
        expression { params.ACTION == 'destroy' }
      }
      steps {
        dir('s3') {
          withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws_jenkins']
          ]) {
            bat '''
              terraform destroy -auto-approve ^
                -var="region=%REGION%" ^
                -var="owner_name=%OWNER_NAME%" ^
                -var="name=%NAME%" ^
                -var="suffix=%SUFFIX%"
            '''
          }
        }
      }
    }

    stage('Post-Deploy Verification') {
      when {
        expression { params.ACTION == 'apply' }
      }
      steps {
        dir('s3') {
          withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws_jenkins']
          ]) {
            bat '''
              aws s3 ls s3://%NAME%-%SUFFIX%
            '''
          }
        }
      }
    }
  }

  post {
    success {
      script {
        echo "Terraform ${params.ACTION} completed successfully."
        try {
          mail to: 'sahilawstesting@gmail.com',
               subject: "Terraform Success: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
               body: "Deployment finished successfully for ${params.ACTION} on ${params.NAME}-${params.SUFFIX}."
        } catch (Exception e) {
          echo "Notification skipped: ${e.getMessage()}"
        }
      }
    }
    failure {
      script {
        echo "Terraform ${params.ACTION} failed. Cleaning workspace."
        try {
          mail to: 'sahilawstesting@gmail.com',
               subject: "Terraform Failure: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
               body: "Terraform ${params.ACTION} failed for ${params.NAME}-${params.SUFFIX}. Please check Jenkins logs."
        } catch (Exception e) {
          echo "Notification skipped: ${e.getMessage()}"
        }
      }
      cleanWs()
    }
    aborted {
      echo 'Job aborted. Cleaning workspace.'
      cleanWs()
    }
  }
}